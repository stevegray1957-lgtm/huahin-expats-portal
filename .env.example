# HuaHin ExpatsPortal — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.
# cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. Production should use a managed Postgres
# (Neon, Supabase, Railway, RDS, etc.).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Admin moderation password (the JWT-gated /admin.html and /admin/* pages).
ADMIN_PASSWORD=change-me-before-going-live

# Secret used to sign the admin auth JWT. Use a long random string.
# JWT_SECRET takes precedence over SESSION_SECRET when both are set.
SESSION_SECRET=replace-with-a-long-random-string
# JWT_SECRET=

# Public base URL of this app. Used for canonical tags, sitemaps, and as the
# default Airwallex success/cancel URL if those are not set in settings.
BASE_URL=https://HuaHinExpatsPortal.com
# Legacy alias kept for compatibility with existing static pages:
SITE_URL=https://HuaHinExpatsPortal.com

# ─── Port (default 3000) ─────────────────────────────────────────────────────
PORT=3000

# ─── Airwallex bootstrap (optional) ──────────────────────────────────────────
# These bootstrap the values used when the `settings` table has no row yet.
# Once an admin saves credentials via /admin/airwallex-settings.html, the DB
# row wins and these env vars become unused. Useful for first boot or for
# headless deploys where the admin UI is not used.

AIRWALLEX_MODE=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

# ─── Google Places bootstrap (optional) ──────────────────────────────────────
# Same logic: provides a default key if the operator hasn't saved one in
# /admin/enrichment.html.
GOOGLE_PLACES_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# NODE_ENV=production
# In production this app enables SSL for Postgres with
# rejectUnauthorized: false. Override DATABASE_URL accordingly.
